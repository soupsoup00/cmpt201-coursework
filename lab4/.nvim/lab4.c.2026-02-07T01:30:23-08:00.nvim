#define _DEFAULT_SOURCE
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define BUF_SIZE 64

struct header {
  uint64_t size;
  struct header *next;
};

void print_out(char *format, void *data, size_t data_size) {
  char buf[BUF_SIZE];
  ssize_t len = snprintf(buf, BUF_SIZE, format,
                         data_size == sizeof(uint64_t) ? *(uint64_t *)data
                                                       : *(void **)data);
  if (len < 0) {
    perror("snprintf");
    exit(EXIT_FAILURE);
  }
  write(STDOUT_FILENO, buf, len);
}

void initialize_block(char *breakptr, struct header *block, struct header *next,
                      int fill_value) {
  block->next = next;
  block->size = 128;

  int fill_area = 128 - sizeof(struct header);
  memset((char*)block + sizeof(struct header), fill_value, fill_area);
}

void print_block(struct header *block, int end) {
  char *blockdata = (char *)block + sizeof(struct header);

  for (int i = 0; i < end; i++) {
    int val = (int)*(blockdata + i);
    print_out("%d", &val, sizeof(&val));
  }

  printf("\n");
}

int main() {
  // increas heap size by 256 bytes w sbrk
  char *breakptr = sbrk(256);
  struct header *block1 = (struct header *)breakptr;
  struct header *block2 = (struct header *)(breakptr + 128);

  // create 2 equal size mem blocks (128 bytes each)
  initialize_block(breakptr, block1, NULL, 0);
  initialize_block(breakptr, block2, block1, 1);
  // print
  print_out("first block: %p\n", &block1, sizeof(&block1));
  print_out("second block: %p\n", &block2, sizeof(&block2));
  print_out("first block size: %lu\n", &block1->size, sizeof(&block1->size));
  print_out("first block next: %p\n", &block2->next, sizeof(&block1->next));
  print_out("second block size: %lu\n", &block2->size, sizeof(&block2->size));
  print_out("second block next: %p\n", &block2->next, sizeof(&block2->next));

  print_block(block1, 128 - sizeof(struct header));
  print_block(block2, 128 - sizeof(struct header));
  return 0;
}
