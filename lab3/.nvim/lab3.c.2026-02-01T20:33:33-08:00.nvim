#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

void print_history(char *arr[], int idx);
char *get_input();
int check_print(char *str, char *arr[]);
void add_history(char *arr[], char *str, int idx);

int main() {
  // read user input, incl spaces
  // store last 5 lines
  // input print to print the stored inputs

  // use array to store [0,1,2,3,4
  // print in same order 0-5, keep count of where current index is

  char *arr[5];
  int idx = 0;

  while (1) {
    printf("Enter input: ");
    add_history(arr, get_input(), (idx % 5));
    idx++;
    if (check_print(arr[idx], arr)) {
      print_history(arr, idx);
    }
  }
  // TODO ; free mem in array
  // free(line);
  return 0;
}

int check_print(char *str, char *arr[]) {
  if (strcmp(str, "print") == 0) {
    //    printf("run");
    return 1;
  }
  return 0;
  //  printf("%s", str);
}

char *get_input() {
  char *line = NULL;
  size_t len = 0;
  ssize_t input = getline(&line, &len, stdin);
  if (input != -1) {
    // remove \n
    line[strcspn(line, "\n")] = 0;
  }
  return line;
}

